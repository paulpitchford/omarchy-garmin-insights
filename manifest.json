{
  "schemaVersion": 1,
  "id": "io.github.paulpitchford.garmin-insights",
  "name": "Garmin Insights",
  "version": "0.2.3",
  "author": "Paul Pitchford",
  "license": "MIT",
  "description": "Recent Garmin Connect activity and bounded daily wellness insights in the Omarchy bar.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Garmin Insights",
    "description": "Recent Garmin Connect activity trends and bounded daily wellness insights.",
    "category": "Health",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "period": "7Days",
      "units": "auto",
      "refreshMinutes": 30,
      "checkForUpdates": true,
      "demoMode": false
    },
    "schema": [
      {
        "key": "period",
        "type": "enum",
        "label": "Bar period",
        "options": ["today", "7Days", "30Days", "90Days"],
        "defaultValue": "7Days"
      },
      {
        "key": "units",
        "type": "enum",
        "label": "Units",
        "options": ["auto", "metric", "imperial"],
        "defaultValue": "auto"
      },
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 5,
        "max": 360,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "checkForUpdates",
        "type": "boolean",
        "label": "Check for updates",
        "defaultValue": true
      },
      {
        "key": "demoMode",
        "type": "boolean",
        "label": "Use synthetic demo data",
        "defaultValue": false
      }
    ]
  }
}
